{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric asset bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "bundleId", "bundleVersion", "supportedFabric", "manifestDigest", "dependencies", "templates"],
  "properties": {
    "contractVersion": { "const": "fabric-assets/v1" },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "bundleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supportedFabric": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependencies": { "type": "array" },
    "templates": { "type": "array" }
  }
}
